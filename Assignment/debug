import java.util.Scanner; // For 2 and 3
public class App {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        //P2: Ask the user for a number. Create a loop to find the factorial of it
        System.out.println("Problem 2");
        System.out.println("Enter a number and I will tell you the factorial: ");
        int num = sc.nextInt();
        factorial(num);

        //P3: Ask the user for a number, and then add together every OTHER digit (starting from 1)
        System.out.println("Problem 3");
        System.out.println("Enter a number and I will tell you the sum of every other number: ");
        int num2 = sc.nextInt();
        sumEveryOtherUpTo(num2);

        //P5: Take a string from the user and print them the reverse!
        System.out.println("Problem 5");
        System.out.println("Enter a string and I will reverse it: ");
        
        sc.nextLine(); // Code wasn't asking for input when I ran it, the problem was apparently being cause by using nextLine after nextInt, this line solved the problem by removing the leftover nextLine
        String input = sc.nextLine();
        reverseString(input);
    }
       
    public static int factorial(int num) {
        int sum = 1; // Starts at one so it doesn't multiply by 0
        for (int i = 0; i < num; i++) {
            sum *= (i + 1); // "i + 1" ensures it doesn't start by multiplying by 0
        }
        System.out.println("The factorial of " + num + " is: " + sum);
        return sum;
    }

    public static int sumEveryOtherUpTo(int num2) {
        int sum2 = 0;
        for (int i = 1; i <= num2; i += 2) { // Start at 1 and increment by 2 to get every other number
            sum2 += i;
        }
        System.out.println("The sum of every other number up to " + num2 + " is: " + sum2);
        return sum2;
    }

    public static String reverseString(String input) {
        String reverse = "";
        for (int i = input.length() - 1; i >= 0; i--) { // Start from the end of the string and move backwards
            reverse += input.charAt(i); // Add each character to the reverse string
        }
        System.out.println("The reverse of the string is: " + reverse);
        return reverse;
    }
}
