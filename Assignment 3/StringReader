import java.util.Scanner;
public class StringReader {
// Renamed the file "StringReader" because it kept running something else when i tried to run it. Both were named "App".
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a string: ");
        
        String input = sc.nextLine();   // Takes input
        for (int i = 0; i < input.length(); i++) { // .length() is used to read the length of the inputted string. The loop will run for how ever many characters there are.
            System.out.println(input.charAt(i)); // .charAt() reads the character at the specified i. For example if i is 0, it will read the first character.
        }   
    }
}

